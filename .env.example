# Admin WhatsApp number — Moroccan numbers, any of these formats work:
#   0661234567      (local format, 0 is stripped and 212 is added)
#   661234567       (9 digits, 212 is added automatically)
#   212661234567    (already international, used as-is)
ADMIN_NUMBER=0661234567

# Path where Baileys stores the auth session files
# On Railway: set to /app/auth_state and mount a volume at that path
AUTH_PATH=./auth_state

# Secret token to access the /reset page (choose anything)
RESET_TOKEN=your_secret_here
